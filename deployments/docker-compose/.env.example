# Copy to .env in this directory to override demo stack settings.
# *_HOST_PORT values are the ports published on your machine; change them
# when another project already uses the defaults. BRIDGE_* values are passed
# to the bridge container, EVENT_DELAY to the mock deployer.
BRIDGE_HOST_PORT=8080
SAMPLE_APP_HOST_PORT=8081
JAEGER_UI_HOST_PORT=16686
OTLP_GRPC_HOST_PORT=4317
OTLP_HTTP_HOST_PORT=4318
REDIS_HOST_PORT=6379

BRIDGE_LOG_LEVEL=info
BRIDGE_LOG_FORMAT=text
BRIDGE_REDIS_TTL=86400

EVENT_DELAY=1s
